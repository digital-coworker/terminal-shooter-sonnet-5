[18.024834, "o", "\u001b[3;76H\u001b[1K \u001b[34m*\u001b[39m\u001b(B\u001b[m  \u001b[4;42H\u001b[34m+\u001b[4;79H:\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[5;97H\u001b[34m*\r\u001b[7d\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[8;37H\u001b[34m*\r\u001b[10d\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[11;16H\u001b[34m*\r\u001b[12d\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[13;13H\u001b(B\u001b[0;1m\u001b[36m!\u001b[13;30H\u001b[39m\u001b(B\u001b[m \u001b[13;90H\u001b[34m:\u001b[14;29H\u001b[39m\u001b(B\u001b[m\u001b[1K \u001b[34m+\u001b[14;46H\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[15;7H \u001b[15;87H \u001b[34m*\u001b[16;7H*\u001b[16;80H\u001b[39m\u001b(B\u001b[m       \u001b[34m:\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[17;28H\u001b[1K \u001b[17;80H\u001b[34m+\u001b[39m\u001b(B\u001b[m \u001b[34m+\u001b[17;91H*\u001b[18;15H+\u001b[18;40H\u001b[39m\u001b(B\u001b[m \u001b[19;38H\u001b[1K \u001b[31m•\u001b[20;31H\u001b[34m:\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[21;49H\u001b[34m:\u001b[22;42H\u001b[39m\u001b(B\u001b[m\u001b[1K \u001b[34m:\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[23;13H\u001b[23;29H\u001b[34m:\u001b[39m\u001b(B\u001b[m  \u001b(B\u001b[0;1m\u001b[36m!\u001b[23;46H\u001b[39m\u001b(B\u001b[m \u001b[23;66H\u001b[34m:\u001b[24;32H\u001b[39m\u001b(B\u001b[m \u001b[24;44H  \u001b[34m:\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[25;63H\u001b[1K \u001b[34m:\u001b[26;23H\u001b[39m\u001b(B\u001b[m\u001b[1K \u001b[34m*\u001b[27;8H*\u001b[29;35H\u001b[39m\u001b(B\u001b[m  \u001b(B\u001b[0;1m\u001b[36m▲\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[30;34H  \u001b(B\u001b[0;1m\u001b[36m/\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[36m\\\u001b[30;76H\u001b(B\u001b[0m\u001b[34m*\u001b[15;54H\u001b[39m\u001b(B\u001b[m"]
